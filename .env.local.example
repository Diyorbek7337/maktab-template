# Bu faylni `.env.local` nomi bilan nusxalang va qiymatlarni to'ldiring.
# `.env.local` .gitignore'da — hech qachon commit qilinmaydi.

# ── Firebase (ommaviy, client'da ishlatiladi) ────────────────
# Firebase Console → Project settings → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Admin panel (MAXFIY) ─────────────────────────────────────
# /admin ga kirish paroli
ADMIN_PASSWORD=

# Sessiya JWT'sini imzolash kaliti — tasodifiy, kamida 32 belgi:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SECRET=

# ── Firebase Admin SDK (MAXFIY, faqat serverda) ──────────────
# Firebase Console → Project settings → Service accounts → Generate new private key
FIREBASE_ADMIN_CLIENT_EMAIL=
# Butun kalitni qo'shtirnoq ichida, \n belgilarini saqlagan holda joylashtiring
FIREBASE_ADMIN_PRIVATE_KEY=""

# ── Telegram bildirishnoma (ixtiyoriy) ───────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Rate limit saqlagichi (ixtiyoriy, tavsiya etiladi) ───────
# Sozlanmasa Firestore fallback avtomatik ishlaydi.
# https://console.upstash.com → Redis → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
