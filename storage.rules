rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Rasm va fayllar sayt uchun ommaviy ko'rinadi, faqat login qilgan
    // admin (Firebase Auth custom token) yuklay/o'chira oladi.
    match /{allPaths=**} {
      allow read: if true;
      // delete'da request.resource mavjud emas — shuning uchun
      // hajm/tur tekshiruvini faqat create/update uchun qo'llaymiz.
      allow delete: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches("image/.*");
    }
  }
}
